+
+// IsWildcard reports whether the tenant's allowlist contains "*", i.e. a
+// full-access tenant that retains pass-through for every method.
+func (t Tenant) IsWildcard() bool {
+	for _, a := range t.AllowedTools {
+		if a == "*" {
+			return true
+		}
+	}
+	return false
+}
