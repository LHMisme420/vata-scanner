// Command mockmcp is a stand-in upstream MCP server for gateway testing.
//
//	mockmcp -addr :9000 -latency 2ms -fail-rate 0.0
package main

import (
	"encoding/json"
	"flag"
	"io"
	"log"
	"math/rand"
	"net/http"
	"time"
)

func main() {
	addr := flag.String("addr", ":9000", "listen address")
	latency := flag.Duration("latency", 0, "artificial per-request latency, e.g. 2ms")
	failRate := flag.Float64("fail-rate", 0, "fraction of requests to fail with 500 [0,1]")
	leakPII := flag.Bool("leak-pii", true, "include an email in results to exercise redaction")
	flag.Parse()

	mux := http.NewServeMux()
	mux.HandleFunc("/mcp", func(w http.ResponseWriter, r *http.Request) {
		if *latency > 0 {
			time.Sleep(*latency)
		}
		if *failRate > 0 && rand.Float64() < *failRate {
			w.WriteHeader(http.StatusInternalServerError)
			return
		}
		var req struct {
			ID     json.RawMessage `json:"id"`
			Method string          `json:"method"`
		}
		body, _ := io.ReadAll(r.Body)
		_ = json.Unmarshal(body, &req)

		w.Header().Set("Content-Type", "application/json")

		// tools/list advertises the FULL upstream catalog — including a
		// destructive tool a scoped tenant must not be able to invoke.
		if req.Method == "tools/list" {
			tools := []map[string]any{
				{
					"name":        "search",
					"description": "Full-text search over the corpus.",
					"inputSchema": map[string]any{
						"type":       "object",
						"properties": map[string]any{"query": map[string]any{"type": "string"}},
						"required":   []string{"query"},
					},
				},
				{
					"name":        "fetch",
					"description": "Fetch a document by id.",
					"inputSchema": map[string]any{
						"type":       "object",
						"properties": map[string]any{"id": map[string]any{"type": "string"}},
						"required":   []string{"id"},
					},
				},
				{
					"name":        "delete_all",
					"description": "DESTRUCTIVE: permanently delete every document in the tenant workspace.",
					"inputSchema": map[string]any{
						"type": "object",
						"properties": map[string]any{
							"confirm": map[string]any{"type": "boolean"},
							"scope":   map[string]any{"type": "string", "enum": []string{"workspace", "global"}},
						},
						"required": []string{"confirm"},
					},
				},
			}
			_ = json.NewEncoder(w).Encode(map[string]any{
				"jsonrpc": "2.0",
				"id":      req.ID,
				"result":  map[string]any{"tools": tools},
			})
			return
		}

		// everything else: echo (exercises PII redaction on the response path).
		text := "hello from mockmcp"
		if *leakPII {
			text = "contact support@corp.com for help"
		}
		_ = json.NewEncoder(w).Encode(map[string]any{
			"jsonrpc": "2.0",
			"id":      req.ID,
			"result":  map[string]any{"content": []map[string]string{{"type": "text", "text": text}}},
		})
	})

	log.Printf("mockmcp listening on %s (latency=%s fail-rate=%.2f)", *addr, *latency, *failRate)
	srv := &http.Server{Addr: *addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
	log.Fatal(srv.ListenAndServe())
}
