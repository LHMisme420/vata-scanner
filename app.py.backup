from flask import Flask, request, jsonify
from flask_cors import CORS
from flask_jwt_extended import JWTManager, create_access_token, jwt_required, get_jwt_identity
import sqlite3
import os
from datetime import datetime, timezone

app = Flask(__name__)
CORS(app, origins="*")
app.config['JWT_SECRET_KEY'] = 'dev-secret-key-change-in-production'
jwt = JWTManager(app)

DB_FILE = 'vata.db'

def init_db():
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS organizations
        (id INTEGER PRIMARY KEY, name TEXT, api_key TEXT, created_at TEXT)''')
    c.execute('''CREATE TABLE IF NOT EXISTS findings
        (id INTEGER PRIMARY KEY, org_id INTEGER, server_url TEXT, vector_type TEXT, severity TEXT, created_at TEXT)''')
    c.execute('''CREATE TABLE IF NOT EXISTS purchases
        (id INTEGER PRIMARY KEY, product_id TEXT, email TEXT, customer_name TEXT, created_at TEXT)''')
    conn.commit()
    conn.close()

init_db()

@app.route('/health', methods=['GET'])
def health():
    return jsonify({'status': 'ok'}), 200

@app.route('/auth/register', methods=['POST'])
def register():
    try:
        org_name = request.json.get('org_name', 'DefaultOrg')
        api_key = f'vata_key_{os.urandom(16).hex()}'
        
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('INSERT INTO organizations (name, api_key, created_at) VALUES (?, ?, ?)',
                  (org_name, api_key, datetime.now(timezone.utc).isoformat()))
        conn.commit()
        org_id = c.lastrowid
        conn.close()
        
        return jsonify({'org_id': org_id, 'api_key': api_key}), 201
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/auth/login', methods=['POST'])
def login():
    try:
        api_key = request.json.get('api_key')
        
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('SELECT id FROM organizations WHERE api_key = ?', (api_key,))
        org = c.fetchone()
        conn.close()
        
        if not org:
            return jsonify({'error': 'Invalid API key'}), 401
        
        access_token = create_access_token(identity=str(org[0]))
        return jsonify({'access_token': access_token}), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/findings', methods=['GET', 'POST'])
@jwt_required()
def findings_handler():
    org_id = int(get_jwt_identity())
    
    if request.method == 'GET':
        try:
            conn = sqlite3.connect(DB_FILE)
            c = conn.cursor()
            c.execute('SELECT server_url, vector_type, severity FROM findings WHERE org_id = ?', (org_id,))
            findings = [{'server_url': row[0], 'vector_type': row[1], 'severity': row[2]} for row in c.fetchall()]
            conn.close()
            return jsonify({'findings': findings}), 200
        except Exception as e:
            return jsonify({'error': str(e)}), 500
    
    elif request.method == 'POST':
        try:
            findings_list = request.json.get('findings', [])
            
            conn = sqlite3.connect(DB_FILE)
            c = conn.cursor()
            
            for finding in findings_list:
                c.execute('''INSERT INTO findings (org_id, server_url, vector_type, severity, created_at)
                    VALUES (?, ?, ?, ?, ?)''',
                    (org_id, finding['server_url'], finding['vector_type'], 
                     finding['severity'], datetime.now(timezone.utc).isoformat()))
            
            conn.commit()
            conn.close()
            
            return jsonify({'inserted': len(findings_list)}), 201
        except Exception as e:
            return jsonify({'error': str(e)}), 500

@app.route('/api/reports/compliance', methods=['POST'])
@jwt_required()
def compliance_report():
    try:
        org_id = int(get_jwt_identity())
        framework = request.json.get('framework', 'SOC2')
        
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('SELECT severity FROM findings WHERE org_id = ?', (org_id,))
        severities = [row[0] for row in c.fetchall()]
        conn.close()
        
        breakdown = {
            'CRITICAL': severities.count('CRITICAL'),
            'HIGH': severities.count('HIGH'),
            'MEDIUM': severities.count('MEDIUM'),
            'LOW': severities.count('LOW')
        }
        
        compliance_score = 100
        if breakdown['CRITICAL'] > 0: compliance_score -= 40
        if breakdown['HIGH'] > 0: compliance_score -= 20
        if breakdown['MEDIUM'] > 0: compliance_score -= 10
        
        compliance_score = max(0, compliance_score)
        
        return jsonify({'framework': framework, 'compliance_score': compliance_score, 'severity_breakdown': breakdown}), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/webhooks/gumroad', methods=['POST'])
def gumroad_webhook():
    try:
        data = request.json
        product_id = data.get('product_id')
        email = data.get('email')
        customer_name = data.get('full_name', 'Customer')
        
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('''INSERT INTO purchases (product_id, email, customer_name, created_at)
            VALUES (?, ?, ?, ?)''',
            (product_id, email, customer_name, datetime.now(timezone.utc).isoformat()))
        conn.commit()
        conn.close()
        
        return jsonify({'status': 'ok', 'product_id': product_id, 'email': email}), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/admin/purchases', methods=['GET'])
def admin_purchases():
    try:
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('SELECT * FROM purchases ORDER BY created_at DESC LIMIT 100')
        purchases = [{'id': row[0], 'product_id': row[1], 'email': row[2], 'customer_name': row[3], 'created_at': row[4]} for row in c.fetchall()]
        conn.close()
        return jsonify({'purchases': purchases}), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500

if __name__ == '__main__':
    app.run(debug=True, host='127.0.0.1', port=5000)

# ============= SCAN SUBMISSION & REPORTS =============

@app.route('/api/scan', methods=['POST'])
@jwt_required()
def submit_scan():
    """Submit scan results and get shareable permalink"""
    try:
        org_id = int(get_jwt_identity())
        data = request.get_json()
        scan_id = str(__import__('uuid').uuid4())
        target_url = data.get('target_url', 'unknown')
        findings = data.get('findings', [])
        
        counts = {'CRITICAL': 0, 'HIGH': 0, 'MEDIUM': 0, 'LOW': 0}
        exposed = 0
        for f in findings:
            sev = f.get('severity', 'LOW').upper()
            if sev in counts:
                counts[sev] += 1
            if sev == 'CRITICAL':
                exposed = 1
        
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('''INSERT INTO scans (id, target_url, findings_count, critical_count, high_count, medium_count, low_count, exposed, organization_id, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)''',
            (scan_id, target_url, len(findings), counts['CRITICAL'], counts['HIGH'], counts['MEDIUM'], counts['LOW'], exposed, org_id, datetime.now(timezone.utc).isoformat()))
        
        for finding in findings:
            c.execute('''INSERT INTO findings (org_id, server_url, vector_type, severity, created_at)
                VALUES (?, ?, ?, ?, ?)''',
                (org_id, target_url, finding.get('title', 'unknown'), finding.get('severity', 'LOW'), datetime.now(timezone.utc).isoformat()))
        
        conn.commit()
        conn.close()
        
        return jsonify({'scan_id': scan_id, 'permalink': f'/report/{scan_id}', 'findings_count': len(findings), 'exposed': exposed}), 201
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/report/<scan_id>')
def view_report(scan_id):
    """Shareable HTML report"""
    try:
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute('SELECT * FROM scans WHERE id = ?', (scan_id,))
        scan = c.fetchone()
        
        if not scan:
            conn.close()
            return '<h1>Report not found</h1>', 404
        
        c.execute('SELECT server_url, vector_type, severity FROM findings WHERE server_url = ?', (scan[1],))
        findings = [{'title': row[1], 'severity': row[2]} for row in c.fetchall()]
        conn.close()
        
        severity_colors = {'CRITICAL': '#e74c3c', 'HIGH': '#e67e22', 'MEDIUM': '#f39c12', 'LOW': '#3498db'}
        findings_html = ''.join([f'<div style="border-left: 4px solid {severity_colors.get(f["severity"].upper(), "#999")}; padding: 15px; margin: 10px 0; background: #f5f5f5;"><h3>{f["title"]}</h3><p><strong>Severity:</strong> <span style="background: {severity_colors.get(f["severity"].upper())}; color: white; padding: 4px 8px; border-radius: 3px;">{f["severity"].upper()}</span></p></div>' for f in findings])
        
        html = f'''<!DOCTYPE html><html><head><title>VATA Scan Report</title><style>body{{font-family:-apple-system,BlinkMacSystemFont,sans-serif;max-width:1000px;margin:40px auto;padding:20px}}.header{{border-bottom:2px solid #333;padding-bottom:20px}}.status{{font-size:32px;font-weight:bold;margin:20px 0}}.exposed{{color:#e74c3c}}.safe{{color:#27ae60}}.summary{{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin:20px 0}}.summary-item{{background:#ecf0f1;padding:15px;border-radius:4px;text-align:center}}.summary-item .number{{font-size:28px;font-weight:bold}}</style></head><body><div class="header"><h1>VATA MCP Security Scan Report</h1><p><strong>Target:</strong> {scan[1]}</p><p><strong>Scan ID:</strong> <code>{scan[0]}</code></p></div><div class="status"><strong>IS YOUR MCP SERVER EXPOSED?</strong><br><span class="{'exposed' if scan[7] else 'safe'}">{'🔴 YES - CRITICAL' if scan[7] else '🟢 NO - SECURE'}</span></div><div class="summary"><div class="summary-item"><div class="number">{scan[3]}</div><div>Critical</div></div><div class="summary-item"><div class="number">{scan[4]}</div><div>High</div></div><div class="summary-item"><div class="number">{scan[5]}</div><div>Medium</div></div><div class="summary-item"><div class="number">{scan[6]}</div><div>Low</div></div></div><h2>Findings ({len(findings)})</h2>{findings_html}<hr><p><small>Shareable report. Share this URL with your team.</small></p></body></html>'''
        return html
    except Exception as e:
        return f'<h1>Error: {str(e)}</h1>', 500
